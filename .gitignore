# DEMASCAS ignore rules

# Environment
.env
venv/
__pycache__/
*.pyc

# Temporary audio files
*.wav

# OS files
.DS_Store

# Whisper GGML models (auto-downloaded by scripts/build.sh)
models/*.bin

# C++ build artifacts
daemon/build/

# Large model directories (auto-downloaded by build.sh)
models/kokoro-en-v0_19/
models/sherpa-onnx/
models/piper/
models/silero_vad.onnx

# Shell config (personal)
.zshrc

# Rust build artifacts
core-rs/target/

# JARVIS exam per-run detail (the summary row lives in docs/exam_history.md)
docs/exam_runs/
